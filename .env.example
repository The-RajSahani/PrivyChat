# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# Public "anon" key. Safe for browsers. It can read nothing without a room token (RLS).
SUPABASE_ANON_KEY=
# SECRET. Server only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. Legacy JWT secret (Project Settings -> API -> JWT). Used to sign short-lived Realtime tokens.
SUPABASE_JWT_SECRET=

# --- App ---
# Random string, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Optional: comma-separated extra origins allowed by CORS (same-origin needs nothing)
ALLOWED_ORIGINS=
